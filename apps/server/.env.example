# 환경 변수 예시 파일
# 이 파일을 .env로 복사하여 사용하세요

TZ=Asia/Seoul

# URL 설정
CLIENT_BASE_URL=http://localhost:3000
SERVER_BASE_URL=http://localhost:4000

# MySQL 데이터베이스
MYSQL_HOST=localhost
MYSQL_DATABASE=your_database_name
MYSQL_USER=your_database_user
MYSQL_PASSWORD=your_database_password
MYSQL_PORT=3306

# JWT 시크릿 키
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
IMAGE_FILE_SALT=your_image_file_salt
OAUTH_REFRESH_SECRET=your_oauth_refresh_secret

# 카카오 OAuth (https://developers.kakao.com)
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_SERVICE_APP_ADMIN_KEY=your_kakao_admin_key

# 네이버 OAuth (https://developers.naver.com)
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CLIENT_ID_WEB=your_google_client_id_web
GOOGLE_CLIENT_ID_IOS=your_google_client_id_ios

# Apple Sign In (https://developer.apple.com)
APPLE_CLIENT_ID=com.yourcompany.appname
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
your_apple_private_key_content
-----END PRIVATE KEY-----"

# Cloudflare R2 스토리지 (https://dash.cloudflare.com)
CLOUDFLARE_R2_IMAGE_BUCKET_NAME=your_bucket_name
CLOUDFLARE_R2_IMAGE_BASE_URL=https://your-r2-public-url.com
CLOUDFLARE_R2_API_BASE_URL=https://your-account-id.r2.cloudflarestorage.com/
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Redis 캐시
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Firebase (https://console.firebase.google.com)
# 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 후 해당 경로에 저장
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# 비-production 환경에서 전체 공지 broadcast 시 발송 대상으로 강제할 테스트 유저 ID.
# dev 등에서는 이 유저에게만 발송되며, 미설정 시 아무에게도 발송되지 않음 (실유저 보호).
ANNOUNCEMENT_TEST_USER_ID=

# Discord 운영자 알림 (선택)
DISCORD_AUCTION_WEBHOOK_URL=