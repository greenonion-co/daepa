{
  "name": "mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --appId com.greenonion.daepa",
    "android:bundle": "cd android && ENVFILE=.env.production ./gradlew clean && ENVFILE=.env.production ./gradlew :react-native-vision-camera:assembleRelease :app:bundleRelease",
    "android:apk": "cd android && ENVFILE=.env.production ./gradlew clean assembleRelease",
    "ios": "react-native run-ios --scheme breedy-alpha",
    "ios:setup": "ENVFILE=.env.development pod install --project-directory=ios && react-native run-ios --scheme breedy-alpha",
    "ios:prod": "ENVFILE=.env.production pod install --project-directory=ios && react-native run-ios --scheme breedy --mode Release",
    "pod:dev": "ENVFILE=.env.development pod install --project-directory=ios",
    "pod:prod": "ENVFILE=.env.production pod install --project-directory=ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@invertase/react-native-apple-authentication": "^2.4.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-cookies/cookies": "^6.2.1",
    "@react-native-firebase/app": "^23.8.4",
    "@react-native-firebase/messaging": "^23.8.4",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-native-seoul/kakao-login": "^5.4.1",
    "@react-native/gradle-plugin": "0.80.2",
    "@react-native/new-app-screen": "0.80.2",
    "@react-navigation/bottom-tabs": "^7.4.6",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.7",
    "@repo/api-client": "workspace:^",
    "@tanstack/react-query": "^5.75.5",
    "axios": "^1.11.0",
    "date-fns": "^4.1.0",
    "jose": "^5.9.6",
    "lottie-react-native": "^7.3.2",
    "lucide-react-native": "^0.539.0",
    "react": "19.1.0",
    "react-native": "0.80.2",
    "react-native-bootsplash": "^6.3.12",
    "react-native-config": "^1.6.1",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-screens": "^4.14.1",
    "react-native-svg": "^15.12.1",
    "react-native-vision-camera": "^4.7.3",
    "react-native-webview": "^13.16.0",
    "zustand": "^5.0.4"
