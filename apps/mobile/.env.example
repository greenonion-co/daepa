# 환경 변수 예시 파일
# 이 파일을 .env로 복사하여 사용하세요

# 앱 식별자 (iOS Bundle ID, Android Application ID)
BUNDLE_ID=com.yourcompany.appname
APP_NAME=앱이름

# 카카오 SDK (https://developers.kakao.com 에서 발급)
KAKAO_APP_KEY=your_kakao_app_key

# Google OAuth 클라이언트 ID (https://console.cloud.google.com 에서 발급)
GOOGLE_CLIENT_ID_WEB=your_google_client_id_web
GOOGLE_CLIENT_ID_IOS=your_google_client_id_ios
GOOGLE_REVERSED_CLIENT_ID=your_google_reversed_client_id

# API 서버 URL
SERVER_BASE_URL=http://192.168.x.x:4000

# 웹 클라이언트 URL
CLIENT_BASE_URL=http://192.168.x.x:3000

# CDN URL
CDN_URL=https://your-cdn-url.com/cdn-cgi/image
